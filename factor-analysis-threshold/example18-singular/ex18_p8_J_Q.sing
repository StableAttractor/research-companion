// [DSS07] Example 18 step (ii): which minimal generators of I_{8,3} lie in J_{8,3}, and least power in J_{8,3}.
// Over the rationals (ring characteristic 0), as in [DSS07, Example 18].
system("--ticks-per-sec",1000); int t0=timer;
< "septads.lib";
ring R = 0,(p11,p22,p33,p44,p55,p66,p77,p88,
            p12,p23,p34,p45,p56,p67,p78,p18,
            p13,p24,p35,p46,p57,p68,p17,p28,
            p14,p25,p36,p47,p58,p16,p27,p38, p15,p26,p37,p48),dp;
execute("ideal Imin = " + read("ex18_I83min.txt") + ";");
ring S = 0,(p12,p23,p34,p45,p56,p67,p78,p18,
            p13,p24,p35,p46,p57,p68,p17,p28,
            p14,p25,p36,p47,p58,p16,p27,p38, p15,p26,p37,p48),dp;
< "septads.lib";
ideal G = imap(R,Imin);
"generators read:", size(G);
// off-diagonal 4x4 minors: R contains 1
ideal Mi; int a,b,c,u,i; intvec RR,CC;
for(a=2;a<=8;a++){for(b=a+1;b<=8;b++){for(c=b+1;c<=8;c++){
  RR=1,a,b,c; CC=0:0; int first=1;
  for(u=2;u<=8;u++){ if(u!=a && u!=b && u!=c){ if(first){CC=u;first=0;} else {CC=CC,u;} } } kill first;
  Mi[size(Mi)+1]=detRC(RR,CC); }}}
"off-diagonal 4x4 minors:", size(Mi), " span dim:", size(interred(Mi));
ideal Sep; intvec T; int s;
for(s=1;s<=8;s++){ T=0:0; int first=1; for(u=1;u<=8;u++){ if(u!=s){ if(first){T=u;first=0;} else {T=T,u;} } } kill first;
  Sep = Sep + septadsOn(T); }
ideal SepI = interred(Sep);
"septads (nonzero linear eliminants, R u C = Rbar u Cbar):", size(Sep), " span dim:", size(SepI);
ideal J = Mi + SepI;
option(redSB); option(redTail);
degBound = 16;
ideal sJ = std(J);
"std(J_{8,3}) with degBound 16 done, ms:", timer-t0, " size:", size(sJ);
// which generators are in J, by degree; rank of normal forms of degree-7 generators
ideal NF7; int n4=0; int n7=0; int n8=0; int d;
ideal Out; intvec outdeg;
for(i=1;i<=size(G);i++){ poly r = reduce(G[i],sJ); d=deg(G[i]);
  if(r==0){ if(d==4){n4++;} if(d==7){n7++;} if(d==8){n8++;} }
  else { Out[size(Out)+1]=G[i]; }
  if(d==7){ NF7[size(NF7)+1]=r; }
  kill r; }
"generators in J: deg4", n4, " deg7", n7, " deg8", n8;
"generators not in J:", size(Out);
"dim of span of normal forms of the 260 degree-7 generators mod J (= dim I_7/J_7):", size(interred(NF7));
degBound = 4; ideal sMi = std(Mi); degBound = 16; int nn4=0; for(i=1;i<=size(G);i++){ if(deg(G[i])==4){ if(reduce(G[i], sMi)==0){nn4++;} } }
"degree-4 generators in the span of the minors:", nn4;
// squares
int sq7=0; int sq8=0; int bad=0;
for(i=1;i<=size(Out);i++){ poly h = Out[i]^2;
  if(reduce(h,sJ)==0){ if(deg(Out[i])==7){sq7++;} else {sq8++;} }
  else { bad++; "SQUARE NOT IN J: generator of degree", deg(Out[i]), " index", i; }
  kill h;
  if(i mod 10 == 0){ "  squares checked:", i, " ms:", timer-t0; }
}
"squares in J: deg7", sq7, " deg8", sq8, " not in J:", bad;
"total ms:", timer-t0;
quit;
