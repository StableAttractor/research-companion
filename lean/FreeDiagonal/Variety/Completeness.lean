import FreeDiagonal.Variety.Elimination

/-!
# `ProjClosed K` for algebraically closed `K` (completeness of `(ℙ¹)ⁿ`)

This file proves the named hypothesis `ProjClosed K` (`Variety/Elimination.lean`), exactly as
stated there, for every algebraically closed field `K` (`projClosed_of_isAlgClosed`).

## The argument (multigraded projective Nullstellensatz, then linear algebra)

Fix `y ∈ K^σ`. Specialising the affine variables to `y` turns each `f ∈ F` into a polynomial
`f_y` in the `2n` pair variables, multihomogeneous of the same multidegree. For `N ∈ ℕ` write
`D_N = (N, …, N)`; the monomials of multidegree `D_N` are `m_a = ∏ λ_i^{a_i} μ_i^{N - a_i}`,
`a : n → Fin (N + 1)`.

* **No common zero ⇒ every `m_a` is a combination of the `u · f_y` of multidegree `D_N`, for some
  `N`.** If no point of `(ℙ¹)ⁿ` is a common zero, every common zero in `K^{2n}` has a zero pair,
  so each `μ_c = ∏_i (λ_i or μ_i, as c_i says)` vanishes on the common zeros. By the affine
  Nullstellensatz (the only use of `IsAlgClosed K`) a power `μ_c^{N₀}` lies in the ideal of the
  `f_y`; with `N = 2N₀` every `m_a` is a multiple of some `μ_c^{N₀}`. Taking the component of
  multidegree `D_N` (the `f_y` are multihomogeneous) gives a `K`-combination of products
  `u · f_y` of multidegree exactly `D_N`.
* **Conversely**, such a combination equal to `m_a` rules out a common zero: at a common zero
  `w`, pick `a` with `m_a(w) ≠ 0`.
* **Openness.** "Every `m_a` is a combination of finitely many `u_k · f_{k,y}`" says that a matrix
  with rows `a` and entries the coefficients of `m_a` in `u_k · f_{k,y}` has full row rank, i.e.
  some maximal minor is non-zero. These coefficients, hence the minors, are polynomials in `y`.

So the projection is the common zero set of ALL such minors, for all `N` and all finite families:
`zeroLocus_elimIdeal`. No bound on `N` is needed, since the ideal may be generated by infinitely
many polynomials.
-/

open Matrix Finset MvPolynomial

universe u

namespace FreeDiagonal

namespace Completeness

variable {K : Type u} [Field K]

variable {σ n : Type} [Fintype σ] [Fintype n] [DecidableEq n]

variable (n) in
/-- The weights of the pair variables alone: `e_i` on `λ_i` and `μ_i`. -/
def wT : n × Bool → (n → ℕ) := fun ib => Pi.single ib.1 1

/-! ### Specialising the affine variables -/

lemma aeval_self {τ : Type*} (x : τ → K) (p : MvPolynomial τ K) : aeval x p = eval x p := rfl

variable (K σ n) in
/-- The pair variables as variables over the ring `K[y]` of the affine variables. -/
noncomputable def splitVars :
    MvPolynomial (σ ⊕ (n × Bool)) K →ₐ[K] MvPolynomial (n × Bool) (MvPolynomial σ K) :=
  aeval (Sum.elim (fun s => C (X s)) X)

/-- `f_y`: the polynomial in the pair variables obtained by putting `y` for the affine variables. -/
noncomputable def spec (y : σ → K) (f : MvPolynomial (σ ⊕ (n × Bool)) K) :
    MvPolynomial (n × Bool) K :=
  MvPolynomial.map (eval y) (splitVars K σ n f)

omit [Fintype σ] [Fintype n] [DecidableEq n] in
lemma eval_spec (y : σ → K) (w : n × Bool → K) (f : MvPolynomial (σ ⊕ (n × Bool)) K) :
    eval w (spec y f) = aeval (Sum.elim y w) f := by
  rw [aeval_self]
  have : ((eval w).comp ((MvPolynomial.map (eval y)).comp (splitVars K σ n).toRingHom)) =
      eval (Sum.elim y w) := by
    apply MvPolynomial.ringHom_ext
    · intro r; simp [splitVars]
    · rintro (s | t) <;> simp [splitVars]
  exact congrArg (fun φ => φ f) this

omit [Fintype n] [DecidableEq n] in
lemma isWeightedHomogeneous_map {τ R S : Type*} [CommSemiring R] [CommSemiring S]
    {w : τ → (n → ℕ)} {p : MvPolynomial τ R} {m : n → ℕ} (hp : p.IsWeightedHomogeneous w m)
    (φ : R →+* S) : (MvPolynomial.map φ p).IsWeightedHomogeneous w m := by
  intro s hs
  apply hp
  intro h
  apply hs
  rw [MvPolynomial.coeff_map, h, map_zero]

omit [Fintype σ] [Fintype n] in
lemma isWeightedHomogeneous_splitVars {f : MvPolynomial (σ ⊕ (n × Bool)) K} {D : n → ℕ}
    (hf : f.IsWeightedHomogeneous (pairWeight σ n) D) :
    (splitVars K σ n f).IsWeightedHomogeneous (wT n) D := by
  induction hf using IsWeightedHomogeneous.induction_on with
  | zero => rw [map_zero]; exact isWeightedHomogeneous_zero _ _ _
  | add p q hp hq ihp ihq => rw [map_add]; exact ihp.add ihq
  | monomial d r hr =>
    have hX : ∀ v : σ ⊕ (n × Bool),
        (splitVars K σ n (X v)).IsWeightedHomogeneous (wT n) (pairWeight σ n v) := by
      rintro (s | t)
      · simp only [splitVars, aeval_X, Sum.elim_inl]
        exact isWeightedHomogeneous_C _ _
      · simp only [splitVars, aeval_X, Sum.elim_inr]
        exact isWeightedHomogeneous_X _ _ _
    rw [monomial_eq, map_mul, Finsupp.prod, map_prod]
    have hprod := IsWeightedHomogeneous.prod d.support
      (fun v => splitVars K σ n (X v ^ d v)) (fun v => d v • pairWeight σ n v)
      (fun v _ => by rw [map_pow]; exact (hX v).pow (d v))
    have hdeg : ∑ v ∈ d.support, d v • pairWeight σ n v = D := by
      rw [← hr, Finsupp.weight_apply, Finsupp.sum]
    rw [hdeg] at hprod
    have hC : splitVars K σ n (C r) = C (C r) := by simp [splitVars]
    rw [hC]
    exact hprod.C_mul (C r)

omit [Fintype σ] [Fintype n] in
lemma isWeightedHomogeneous_spec (y : σ → K) {f : MvPolynomial (σ ⊕ (n × Bool)) K}
    {D : n → ℕ} (hf : f.IsWeightedHomogeneous (pairWeight σ n) D) :
    (spec y f).IsWeightedHomogeneous (wT n) D :=
  isWeightedHomogeneous_map (isWeightedHomogeneous_splitVars hf) _

/-! ### The monomials of multidegree `(N, …, N)` -/

/-- The exponent of `m_a = ∏ λ_i^{a_i} μ_i^{N - a_i}`. -/
noncomputable def expo (N : ℕ) (a : n → Fin (N + 1)) : n × Bool →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun ib => if ib.2 then N - a ib.1 else a ib.1)

omit [DecidableEq n] in
lemma expo_false (N : ℕ) (a : n → Fin (N + 1)) (i : n) : expo N a (i, false) = a i := by
  simp [expo]

omit [DecidableEq n] in
lemma expo_true (N : ℕ) (a : n → Fin (N + 1)) (i : n) : expo N a (i, true) = N - a i := by
  simp [expo]

lemma weight_wT_apply (s : n × Bool →₀ ℕ) (i : n) :
    Finsupp.weight (wT n) s i = s (i, false) + s (i, true) := by
  rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp)]
  simp only [Finset.sum_apply, Pi.smul_apply, wT, Pi.single_apply, smul_eq_mul, mul_ite,
    mul_one, mul_zero, Fintype.sum_prod_type, Fintype.sum_bool, Finset.sum_add_distrib]
  simp [add_comm]

lemma weight_expo (N : ℕ) (a : n → Fin (N + 1)) :
    Finsupp.weight (wT n) (expo N a) = fun _ => N := by
  funext i
  rw [weight_wT_apply, expo_false, expo_true]
  have := (a i).isLt
  omega

lemma exists_expo_of_weight (N : ℕ) (s : n × Bool →₀ ℕ)
    (hs : Finsupp.weight (wT n) s = fun _ => N) : ∃ a : n → Fin (N + 1), expo N a = s := by
  have h : ∀ i, s (i, false) + s (i, true) = N := fun i => by
    rw [← weight_wT_apply, hs]
  refine ⟨fun i => ⟨s (i, false), by have := h i; omega⟩, ?_⟩
  ext ⟨i, b⟩
  cases b
  · simp [expo_false]
  · simp only [expo_true]; have := h i; omega

omit [DecidableEq n] in
lemma expo_injective (N : ℕ) : Function.Injective (expo (n := n) N) := by
  intro a a' h
  funext i
  apply Fin.ext
  have := congrArg (fun s => s (i, false)) h
  simpa [expo_false] using this

/-- The monomial `m_a`. -/
noncomputable def mono (N : ℕ) (a : n → Fin (N + 1)) : MvPolynomial (n × Bool) K :=
  monomial (expo N a) 1

lemma isWeightedHomogeneous_mono (N : ℕ) (a : n → Fin (N + 1)) :
    (mono (K := K) N a).IsWeightedHomogeneous (wT n) (fun _ => N) :=
  isWeightedHomogeneous_monomial _ _ _ (weight_expo N a)

variable (K) in
/-- The coefficients of the monomials `m_a`. -/
noncomputable def kap (N : ℕ) : MvPolynomial (n × Bool) K →ₗ[K] ((n → Fin (N + 1)) → K) where
  toFun q a := q.coeff (expo N a)
  map_add' p q := by funext a; simp
  map_smul' c p := by funext a; simp

omit [DecidableEq n] in
lemma kap_apply (N : ℕ) (q : MvPolynomial (n × Bool) K) (a : n → Fin (N + 1)) :
    kap K N q a = q.coeff (expo N a) := rfl

lemma kap_mono (N : ℕ) (a : n → Fin (N + 1)) : kap K N (mono N a) = Pi.single a 1 := by
  funext a'
  rw [kap_apply, mono, MvPolynomial.coeff_monomial, Pi.single_apply]
  by_cases h : a' = a
  · subst h; simp
  · have h1 : ¬ expo N a = expo N a' := fun he => h (expo_injective N he).symm
    simp [h1, h]

/-- A polynomial of multidegree `(N, …, N)` whose coefficient vector is `e_{a₀}` is `m_{a₀}`. -/
lemma eq_mono_of_kap (N : ℕ) (q : MvPolynomial (n × Bool) K)
    (hq : q.IsWeightedHomogeneous (wT n) (fun _ => N)) (a₀ : n → Fin (N + 1))
    (h : kap K N q = Pi.single a₀ 1) : q = mono N a₀ := by
  ext s
  by_cases hs : Finsupp.weight (wT n) s = fun _ => N
  · obtain ⟨a, rfl⟩ := exists_expo_of_weight N s hs
    have := congrFun h a
    rw [kap_apply] at this
    rw [this, mono, MvPolynomial.coeff_monomial, Pi.single_apply]
    by_cases ha : a = a₀
    · subst ha; simp
    · have h1 : ¬ expo N a₀ = expo N a := fun he => ha (expo_injective N he).symm
      simp [h1, ha]
  · rw [hq.coeff_eq_zero s hs, mono, MvPolynomial.coeff_monomial]
    have h1 : ¬ expo N a₀ = s := fun he => hs (he ▸ weight_expo N a₀)
    simp [h1]

omit [DecidableEq n] in
/-- At a point of `(ℙ¹)ⁿ` some `m_a` does not vanish. -/
lemma exists_eval_mono_ne_zero (N : ℕ) (w : n × Bool → K)
    (hw : ∀ i, w (i, false) ≠ 0 ∨ w (i, true) ≠ 0) :
    ∃ a : n → Fin (N + 1), eval w (mono N a) ≠ 0 := by
  classical
  refine ⟨fun i => if w (i, false) ≠ 0 then Fin.last N else 0, ?_⟩
  rw [mono, eval_monomial, one_mul, Finsupp.prod]
  refine Finset.prod_ne_zero_iff.2 (fun t _ => ?_)
  obtain ⟨i, b⟩ := t
  cases b
  · rw [expo_false]
    by_cases h : w (i, false) ≠ 0
    · exact pow_ne_zero _ h
    · simp [h]
  · rw [expo_true]
    by_cases h : w (i, false) ≠ 0
    · simp [h]
    · exact pow_ne_zero _ ((hw i).resolve_left h)

/-! ### Columns and the matrices of coefficients -/

variable (F : Set (MvPolynomial (σ ⊕ (n × Bool)) K))

/-- The admissible products `u · f` (`f ∈ F` multihomogeneous of degree `d`, `u` a monomial in the
pair variables) of multidegree `(N, …, N)`. -/
def ColIdx (N : ℕ) : Type u :=
  {c : MvPolynomial (σ ⊕ (n × Bool)) K × (n × Bool →₀ ℕ) // c.1 ∈ F ∧
    ∃ d : n → ℕ, c.1.IsWeightedHomogeneous (pairWeight σ n) d ∧
      Finsupp.weight (wT n) c.2 + d = fun _ => N}

variable {F}

/-- `u · f` over `K[y]`. -/
noncomputable def colPoly {N : ℕ} (c : ColIdx F N) :
    MvPolynomial (n × Bool) (MvPolynomial σ K) :=
  monomial c.1.2 1 * splitVars K σ n c.1.1

/-- `u · f_y`. -/
noncomputable def colSpec (y : σ → K) {N : ℕ} (c : ColIdx F N) : MvPolynomial (n × Bool) K :=
  monomial c.1.2 1 * spec y c.1.1

omit [Fintype σ] [Fintype n] in
lemma map_colPoly (y : σ → K) {N : ℕ} (c : ColIdx F N) :
    MvPolynomial.map (eval y) (colPoly c) = colSpec y c := by
  simp [colPoly, colSpec, spec]

omit [Fintype σ] [Fintype n] in
lemma isWeightedHomogeneous_colSpec (y : σ → K) {N : ℕ} (c : ColIdx F N) :
    (colSpec y c).IsWeightedHomogeneous (wT n) (fun _ => N) := by
  obtain ⟨d, hd, he⟩ := c.2.2
  have := (isWeightedHomogeneous_monomial (wT n) c.1.2 (1 : K) rfl).mul
    (isWeightedHomogeneous_spec y hd)
  rwa [he] at this

/-- The matrix of polynomials in `y`: row `a`, column `k`: the coefficient of `m_a` in
`u_k · f_k`. -/
noncomputable def polyMat {N ℓ : ℕ} (fam : Fin ℓ → ColIdx F N) :
    Matrix (n → Fin (N + 1)) (Fin ℓ) (MvPolynomial σ K) :=
  Matrix.of fun a k => (colPoly (fam k)).coeff (expo N a)

/-- Its value at `y`. -/
noncomputable def valMat (y : σ → K) {N ℓ : ℕ} (fam : Fin ℓ → ColIdx F N) :
    Matrix (n → Fin (N + 1)) (Fin ℓ) K :=
  Matrix.of fun a k => kap K N (colSpec y (fam k)) a

omit [Fintype σ] in
lemma map_polyMat (y : σ → K) {N ℓ : ℕ} (fam : Fin ℓ → ColIdx F N) :
    (polyMat fam).map (eval y) = valMat y fam := by
  ext a k
  simp only [map_apply, polyMat, valMat, of_apply, kap_apply]
  rw [← map_colPoly, MvPolynomial.coeff_map]

omit [Fintype σ] in
lemma mapMatrix_submatrix_polyMat (y : σ → K) {N ℓ : ℕ} (fam : Fin ℓ → ColIdx F N) {k : ℕ}
    (r : Fin k → (n → Fin (N + 1))) (c : Fin k → Fin ℓ) :
    (eval y).mapMatrix ((polyMat fam).submatrix r c) = (valMat y fam).submatrix r c := by
  rw [← map_polyMat]; rfl

variable (n) in
/-- `(N + 1)ⁿ - 1`: one less than the number of monomials `m_a`. -/
def rk (N : ℕ) : ℕ := Fintype.card (n → Fin (N + 1)) - 1

lemma rk_succ (N : ℕ) : rk n N + 1 = Fintype.card (n → Fin (N + 1)) := by
  have : 0 < Fintype.card (n → Fin (N + 1)) := Fintype.card_pos_iff.2 ⟨fun _ => 0⟩
  unfold rk; omega

variable (F) in
/-- The generators: all maximal minors of all coefficient matrices, for all `N`. -/
def elimGens : Set (MvPolynomial σ K) :=
  {g | ∃ (N ℓ : ℕ) (fam : Fin ℓ → ColIdx F N) (r : Fin (rk n N + 1) → (n → Fin (N + 1)))
    (c : Fin (rk n N + 1) → Fin ℓ), g = ((polyMat fam).submatrix r c).det}

variable (F) in
/-- **The elimination ideal.** -/
noncomputable def elimIdeal : Ideal (MvPolynomial σ K) := Ideal.span (elimGens F)

omit [Fintype σ] in
lemma mem_zeroLocus_elimIdeal_iff (y : σ → K) :
    y ∈ zeroLocus K (elimIdeal F) ↔
      ∀ (N ℓ : ℕ) (fam : Fin ℓ → ColIdx F N), (valMat y fam).rank ≤ rk n N := by
  rw [elimIdeal, mem_zeroLocus_iff_le_ker, Ideal.span_le]
  constructor
  · intro h N ℓ fam
    rw [rank_le_iff_minors]
    intro r c
    have := RingHom.mem_ker.1 (h ⟨N, ℓ, fam, r, c, rfl⟩)
    rw [aeval_self, RingHom.map_det, mapMatrix_submatrix_polyMat] at this
    exact this
  · rintro h g ⟨N, ℓ, fam, r, c, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, aeval_self, RingHom.map_det,
      mapMatrix_submatrix_polyMat]
    exact (rank_le_iff_minors _ _).1 (h N ℓ fam) r c

/-! ### A common zero forces rank below full -/

/-- The projection of the zero set. -/
def image (F : Set (MvPolynomial (σ ⊕ (n × Bool)) K)) : Set (σ → K) :=
  {y | ∃ w : n × Bool → K, (∀ i, w (i, false) ≠ 0 ∨ w (i, true) ≠ 0) ∧
    ∀ f ∈ F, aeval (Sum.elim y w) f = 0}

omit [Fintype σ] in
lemma col_valMat (y : σ → K) {N ℓ : ℕ} (fam : Fin ℓ → ColIdx F N) (k : Fin ℓ) :
    (valMat y fam).col k = kap K N (colSpec y (fam k)) := by
  funext a; rfl

omit [Fintype σ] in
lemma rank_le_of_mem_image {y : σ → K} (hy : y ∈ image F) (N ℓ : ℕ)
    (fam : Fin ℓ → ColIdx F N) : (valMat y fam).rank ≤ rk n N := by
  obtain ⟨w, hw, hz⟩ := hy
  by_contra hlt
  rw [not_le] at hlt
  -- full rank: the columns span
  have htop : Submodule.span K (Set.range (valMat y fam).col) = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [← rank_eq_finrank_span_cols]
    apply le_antisymm
    · rw [rank_eq_finrank_span_cols]; exact Submodule.finrank_le _
    · rw [Module.finrank_fintype_fun_eq_card, ← rk_succ]; omega
  obtain ⟨a₀, ha₀⟩ := exists_eval_mono_ne_zero (K := K) N w hw
  have hmem : (Pi.single a₀ 1 : (n → Fin (N + 1)) → K) ∈
      Submodule.span K (Set.range (valMat y fam).col) := by rw [htop]; trivial
  obtain ⟨cf, hcf⟩ := (Submodule.mem_span_range_iff_exists_fun K).1 hmem
  set q := ∑ k, cf k • colSpec y (fam k)
  have hq : q.IsWeightedHomogeneous (wT n) (fun _ => N) := by
    apply IsWeightedHomogeneous.sum
    intro k _
    rw [smul_eq_C_mul]
    exact (isWeightedHomogeneous_colSpec y (fam k)).C_mul _
  have hkq : kap K N q = Pi.single a₀ 1 := by
    rw [← hcf, map_sum]
    simp only [map_smul, col_valMat]
  have hqm := eq_mono_of_kap N q hq a₀ hkq
  apply ha₀
  rw [← hqm, map_sum]
  apply Finset.sum_eq_zero
  intro k _
  rw [smul_eq_C_mul, map_mul, colSpec, map_mul, eval_spec, hz _ (fam k).2.1, mul_zero, mul_zero]

/-! ### No common zero gives full rank for some `N` (the Nullstellensatz) -/

/-- `μ_c`: one variable of each pair, as `c` says. -/
noncomputable def ec (c : n → Bool) : n × Bool →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun ib => if ib.2 = c ib.1 then 1 else 0)

omit [DecidableEq n] in
lemma ec_apply (c : n → Bool) (i : n) (b : Bool) :
    ec c (i, b) = if b = c i then 1 else 0 := by simp [ec]

omit [DecidableEq n] in
lemma ec_self (c : n → Bool) (i : n) : ec c (i, c i) = 1 := by simp [ec]

variable (F) in
/-- The `K`-span of all products `u · f_y`. -/
noncomputable def spanAll (y : σ → K) : Submodule K (MvPolynomial (n × Bool) K) :=
  Submodule.span K {q | ∃ f ∈ F, ∃ u : n × Bool →₀ ℕ, q = monomial u 1 * spec y f}

omit [Fintype σ] [Fintype n] [DecidableEq n] in
lemma X_mul_mem_spanAll (y : σ → K) (t : n × Bool) {v : MvPolynomial (n × Bool) K}
    (hv : v ∈ spanAll F y) : X t * v ∈ spanAll F y := by
  induction hv using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨f, hf, u, rfl⟩ := hx
    apply Submodule.subset_span
    refine ⟨f, hf, Finsupp.single t 1 + u, ?_⟩
    rw [← mul_assoc]
    show monomial (Finsupp.single t 1) (1 : K) * monomial u 1 * spec y f = _
    rw [monomial_mul_monomial, one_mul]
  | zero => rw [mul_zero]; exact Submodule.zero_mem _
  | add x z _ _ hx hz => rw [mul_add]; exact Submodule.add_mem _ hx hz
  | smul a x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ a hx

omit [Fintype σ] [Fintype n] [DecidableEq n] in
lemma mul_mem_spanAll (y : σ → K) (p : MvPolynomial (n × Bool) K) :
    ∀ v ∈ spanAll F y, p * v ∈ spanAll F y := by
  induction p using MvPolynomial.induction_on with
  | C a => intro v hv; rw [← smul_eq_C_mul]; exact Submodule.smul_mem _ a hv
  | add p q hp hq => intro v hv; rw [add_mul]; exact Submodule.add_mem _ (hp v hv) (hq v hv)
  | mul_X p t hp => intro v hv; rw [mul_assoc]; exact hp _ (X_mul_mem_spanAll y t hv)

variable (F) in
/-- `spanAll` is an ideal: the ideal generated by the `f_y`. -/
noncomputable def spanAllIdeal (y : σ → K) : Ideal (MvPolynomial (n × Bool) K) where
  carrier := spanAll F y
  add_mem' := Submodule.add_mem _
  zero_mem' := Submodule.zero_mem _
  smul_mem' p v hv := mul_mem_spanAll y p v hv

omit [Fintype σ] [Fintype n] [DecidableEq n] in
lemma span_spec_le (y : σ → K) :
    Ideal.span (spec y '' F) ≤ spanAllIdeal F y := by
  rw [Ideal.span_le]
  rintro _ ⟨f, hf, rfl⟩
  apply Submodule.subset_span
  exact ⟨f, hf, 0, by rw [monomial_zero', C_1, one_mul]⟩

variable (F) in
/-- The `K`-span of the admissible `u · f_y` of multidegree `(N, …, N)`. -/
noncomputable def spanD (y : σ → K) (N : ℕ) : Submodule K (MvPolynomial (n × Bool) K) :=
  Submodule.span K {q | ∃ c : ColIdx F N, q = colSpec y c}

omit [Fintype σ] in
lemma map_spanAll_le (hF : ∀ f ∈ F, ∃ D : n → ℕ, f.IsWeightedHomogeneous (pairWeight σ n) D)
    (y : σ → K) (N : ℕ) :
    (spanAll F y).map (weightedHomogeneousComponent (wT n) (fun _ => N)) ≤ spanD F y N := by
  rw [spanAll, Submodule.map_span_le]
  rintro _ ⟨f, hf, u, rfl⟩
  obtain ⟨d, hd⟩ := hF f hf
  have hg := (isWeightedHomogeneous_monomial (wT n) u (1 : K) rfl).mul
    (isWeightedHomogeneous_spec y hd)
  by_cases he : Finsupp.weight (wT n) u + d = fun _ => N
  · rw [← he, hg.weightedHomogeneousComponent_same]
    exact Submodule.subset_span ⟨⟨(f, u), hf, d, hd, he⟩, rfl⟩
  · rw [hg.weightedHomogeneousComponent_ne _ (Ne.symm he)]
    exact Submodule.zero_mem _

omit [Fintype σ] in
lemma exists_rank_of_not_mem_image [IsAlgClosed K]
    (hF : ∀ f ∈ F, ∃ D : n → ℕ, f.IsWeightedHomogeneous (pairWeight σ n) D)
    {y : σ → K} (hy : y ∉ image F) :
    ∃ (N ℓ : ℕ) (fam : Fin ℓ → ColIdx F N), ¬ (valMat y fam).rank ≤ rk n N := by
  classical
  set I := Ideal.span (spec y '' F)
  -- (1) each `μ_c` vanishes on the common zeros, so a power lies in `I` (Nullstellensatz)
  have hrad : ∀ c : n → Bool, monomial (ec c) (1 : K) ∈ I.radical := by
    intro c
    rw [← vanishingIdeal_zeroLocus_eq_radical (K := K), mem_vanishingIdeal_iff]
    intro w hw
    rw [mem_zeroLocus_iff] at hw
    have hzero : ∀ f ∈ F, aeval (Sum.elim y w) f = 0 := by
      intro f hf
      have := hw _ (Ideal.subset_span ⟨f, hf, rfl⟩)
      rwa [aeval_self, eval_spec] at this
    have hpair : ∃ i, w (i, false) = 0 ∧ w (i, true) = 0 := by
      by_contra hc
      push Not at hc
      exact hy ⟨w, fun i => by
        by_contra h'; push Not at h'; exact hc i h'.1 h'.2, hzero⟩
    obtain ⟨i, hi0, hi1⟩ := hpair
    rw [aeval_self, eval_monomial, one_mul, Finsupp.prod]
    apply Finset.prod_eq_zero (i := (i, c i))
    · rw [Finsupp.mem_support_iff, ec_self]; exact one_ne_zero
    · rw [ec_self, pow_one]
      cases h : c i
      · exact hi0
      · exact hi1
  choose Nc hNc using hrad
  set N₀ := Finset.univ.sup Nc
  have hpow : ∀ c, monomial (N₀ • ec c) (1 : K) ∈ I := by
    intro c
    have := I.pow_mem_of_pow_mem (hNc c) (Finset.le_sup (f := Nc) (Finset.mem_univ c))
    rwa [monomial_pow, one_pow] at this
  -- (2) with `N = 2 N₀`, every `m_a` lies in `I`
  set N := 2 * N₀
  have hmonoI : ∀ a : n → Fin (N + 1), mono N a ∈ I := by
    intro a
    set c : n → Bool := fun i => decide ((a i : ℕ) < N₀)
    have hle : N₀ • ec c ≤ expo N a := by
      intro ⟨i, b⟩
      simp only [Finsupp.smul_apply, smul_eq_mul, ec_apply]
      have := (a i).isLt
      cases b
      · rw [expo_false]
        by_cases h : (a i : ℕ) < N₀
        · have : c i = true := by simp [c, h]
          simp [this]
        · have : c i = false := by simp [c, h]
          simp [this]; omega
      · rw [expo_true]
        by_cases h : (a i : ℕ) < N₀
        · have : c i = true := by simp [c, h]
          simp [this]; omega
        · have : c i = false := by simp [c, h]
          simp [this]
    have : mono (K := K) N a = monomial (N₀ • ec c) 1 * monomial (expo N a - N₀ • ec c) 1 := by
      rw [mono, monomial_mul_monomial, one_mul, add_tsub_cancel_of_le hle]
    rw [this]
    exact Ideal.mul_mem_right _ _ (hpow c)
  -- (3) the component of multidegree `(N, …, N)`
  have hmonoD : ∀ a : n → Fin (N + 1), mono N a ∈ spanD F y N := by
    intro a
    apply map_spanAll_le hF y N
    refine ⟨mono N a, span_spec_le y (hmonoI a), ?_⟩
    exact (isWeightedHomogeneous_mono N a).weightedHomogeneousComponent_same
  -- (4) finitely many columns suffice
  choose Ta hTa hmemTa using fun a => Submodule.mem_span_finite_of_mem_span (hmonoD a)
  set T := Finset.univ.biUnion Ta
  have hT : ∀ q ∈ T, ∃ c : ColIdx F N, q = colSpec y c := by
    intro q hq
    obtain ⟨a, -, ha⟩ := Finset.mem_biUnion.1 hq
    exact hTa a ha
  choose col hcol using hT
  set e := T.equivFin
  let fam : Fin T.card → ColIdx F N := fun k => col (e.symm k) (e.symm k).2
  refine ⟨N, T.card, fam, ?_⟩
  have hspan : Submodule.span K (Set.range (valMat y fam).col) = ⊤ := by
    rw [eq_top_iff, ← (Pi.basisFun K (n → Fin (N + 1))).span_eq, Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    rw [Pi.basisFun_apply, ← kap_mono]
    have h1 : mono (K := K) N a ∈ Submodule.span K (T : Set (MvPolynomial (n × Bool) K)) :=
      Submodule.span_mono (fun q hq => Finset.mem_biUnion.2 ⟨a, Finset.mem_univ a, hq⟩)
        (hmemTa a)
    have h2 := Submodule.mem_map_of_mem (f := kap K N) h1
    rw [Submodule.map_span] at h2
    refine Submodule.span_mono ?_ h2
    rintro _ ⟨q, hq, rfl⟩
    refine ⟨e ⟨q, hq⟩, ?_⟩
    rw [col_valMat]
    simp only [fam, Equiv.symm_apply_apply]
    rw [← hcol q hq]
  rw [rank_eq_finrank_span_cols, hspan, finrank_top, Module.finrank_fintype_fun_eq_card,
    ← rk_succ]
  omega

/-! ### The theorem -/

omit [Fintype σ] in
/-- **The projection of the zero set is the zero set of the elimination ideal** (`K`
algebraically closed). -/
theorem zeroLocus_elimIdeal [IsAlgClosed K]
    (hF : ∀ f ∈ F, ∃ D : n → ℕ, f.IsWeightedHomogeneous (pairWeight σ n) D) :
    zeroLocus K (elimIdeal F) = image F := by
  ext y
  rw [mem_zeroLocus_elimIdeal_iff]
  constructor
  · intro h
    by_contra hy
    obtain ⟨N, ℓ, fam, hr⟩ := exists_rank_of_not_mem_image hF hy
    exact hr (h N ℓ fam)
  · intro hy N ℓ fam
    exact rank_le_of_mem_image hy N ℓ fam

end Completeness

/-- **`ProjClosed K` holds for every algebraically closed field `K`** (completeness of
`(ℙ¹)ⁿ`, main theorem of elimination theory, in the exact form of the named hypothesis). -/
theorem projClosed_of_isAlgClosed (K : Type u) [Field K] [IsAlgClosed K] : ProjClosed K := by
  intro σ n _ _ _ F hF
  exact ⟨Completeness.elimIdeal F, Completeness.zeroLocus_elimIdeal hF⟩

end FreeDiagonal
