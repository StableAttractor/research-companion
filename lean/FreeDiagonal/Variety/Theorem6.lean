import FreeDiagonal.Variety.Sharpness
import FreeDiagonal.Variety.Elimination

/-!
# Theorem 6: Conjecture 28 of Drton, Sturmfels and Sullivant (three factors)

`J_{p,3} ⊆ ℝ[ψ_ij : i < j]` is generated by the off-diagonal `4 × 4` minors and the septads, and
Theorem 6 says `rad J_{p,3} = I_{p,3}` for every `p`. The proof combines one published computation,
[DSS07, Example 18] at `p = 8`, with an argument of our own. Here the computation is the named
hypothesis `DSSExample18`, in the weakest form the proof uses:

  `DSSExample18 : I_{8,3} ≤ rad J_{8,3}`  (every element of `I_{8,3}` has a power in `J_{8,3}`).

`dssExample18_iff_radical_eq` shows that this is the same as `rad J_{8,3} = I_{8,3}`, and
`dssExample18_iff_points` that it is the same as `V_ℂ(J_{8,3}) ⊆ X_{8,3}`.

## Septads

With `Ψ⁰` the symmetric matrix of the variables with zero diagonal (`Psi0`), the septad of
`i` and of the ordered triples `r, c, r', c'` is
  `det Ψ⁰[r, c] · det Ψ⁰[(i, r'), (i, c')] − det Ψ⁰[r', c'] · det Ψ⁰[(i, r), (i, c)]`
(`septadVal`), for `r, c` injective with disjoint images, likewise `r', c'`, `i` outside the images,
and `range r ∪ range c = range r' ∪ range c'` (`IsSeptadIdx`). `(i, r)` is the 4-tuple with `i`
first. This is the "linear eliminant" of [DSS07] restricted to `R ∪ C = R' ∪ C'`, as quoted in
Part 53. Since `R ∩ C = ∅`, `Ψ[R, C] = Ψ⁰[R, C]`.

The definition in Section 3 of version 3 of the paper is WEAKER: it lets `g` and `h` be any
determinants of submatrices of `Ψ⁰` whose row and column sets contain `i`. Read literally, that
family contains polynomials outside `I_{7,3}` (`literal_septad_not_mem`). What is needed is the
pairing `g = det Ψ⁰[{i} ∪ R̄, {i} ∪ C̄]`, `h = det Ψ⁰[{i} ∪ R, {i} ∪ C]`, with each index set ordered
the same way in both factors. (The order itself does not matter: putting `i` first or sorting the
sets changes both terms by the same sign, because `R ∪ C = R̄ ∪ C̄`. The Lean takes ordered triples
with `i` first, which covers every ordering.)

## Structure

* `Jideal_le_FAideal` (no hypothesis): `J_{p,3} ⊆ I_{p,3}`. The key step is
  `det Ψ⁰[(i,r),(i,c)] = −S_ii det S[r,c]` when the `4 × 4` minors of `S` vanish
  (`det_cons_zeroDiag`).
* `mem_zeroLocus_Jideal_iff`: `z ∈ V(J)` iff all minors and septads vanish at the matrix of `z`.
* Restriction (`msVanish_submatrix`) and extension by zero rows and columns
  (`msVanish_of_zeroExt`), the latter being the paper's argument for `p = 7`.
* `Xvar_comp_symMap` (no hypothesis): sub-patterns of points of `X_{n,k}` lie in `X_{m,k}`.
* `zeroLocus_Jideal_subset_of_le_eight` (under `DSSExample18` only): for at most 8 indices,
  `V(J) ⊆ X`. This covers `p ≤ 7`, INCLUDING `p ≤ 6`: the zero extension makes [DSS07, Theorem 2]
  unnecessary.
* `zeroLocus_Jideal_subset_of_ge_eight` (under `ClosedRhoSym ℂ`, from `ProjClosed ℂ`): `p ≥ 8` by
  Theorem 3.
* `theorem_6_le_eight` (under `DSSExample18` only) and `theorem_6` (under `ProjClosed ℂ` and
  `DSSExample18`).
-/

open Matrix Finset MvPolynomial

namespace FreeDiagonal

/-! ### Minors and septads as values of a matrix -/

section Values

variable {n : Type*} {A : Type*} [CommRing A]

/-- `(r, c)` index an off-diagonal minor: `r`, `c` injective with disjoint images. -/
def IsOffMinorIdx {k : ℕ} (r c : Fin k → n) : Prop :=
  Function.Injective r ∧ Function.Injective c ∧ ∀ a b, r a ≠ c b

/-- The index data of a septad: `(r, c)` and `(r', c')` off-diagonal triples, `i` outside
`R ∪ C`, and `R ∪ C = R' ∪ C'`. -/
def IsSeptadIdx (i : n) (r c r' c' : Fin 3 → n) : Prop :=
  IsOffMinorIdx r c ∧ IsOffMinorIdx r' c' ∧ i ∉ Set.range r ∧ i ∉ Set.range c ∧
    Set.range r ∪ Set.range c = Set.range r' ∪ Set.range c'

/-- The minor `det M[r, c]`. -/
def minorVal {k : ℕ} (M : Matrix n n A) (r c : Fin k → n) : A := (M.submatrix r c).det

/-- The septad `det M[r,c] · det M[(i,r'),(i,c')] − det M[r',c'] · det M[(i,r),(i,c)]`. -/
def septadVal (M : Matrix n n A) (i : n) (r c r' c' : Fin 3 → n) : A :=
  (M.submatrix r c).det * (M.submatrix (vecCons i r') (vecCons i c')).det -
    (M.submatrix r' c').det * (M.submatrix (vecCons i r) (vecCons i c)).det

/-- All off-diagonal `4 × 4` minors and all septads of `M` vanish. -/
def MSVanish (M : Matrix n n A) : Prop :=
  (∀ r c : Fin 4 → n, IsOffMinorIdx r c → minorVal M r c = 0) ∧
    ∀ (i : n) (r c r' c' : Fin 3 → n), IsSeptadIdx i r c r' c' → septadVal M i r c r' c' = 0

lemma IsSeptadIdx.not_mem' {i : n} {r c r' c' : Fin 3 → n} (h : IsSeptadIdx i r c r' c') :
    i ∉ Set.range r' ∧ i ∉ Set.range c' := by
  have hi : i ∉ Set.range r ∪ Set.range c := fun hm => hm.elim h.2.2.1 h.2.2.2.1
  rw [h.2.2.2.2] at hi
  exact ⟨fun hm => hi (Or.inl hm), fun hm => hi (Or.inr hm)⟩

lemma comp_vecCons {m : Type*} (e : m → n) (i : m) {k : ℕ} (r : Fin k → m) :
    e ∘ vecCons i r = vecCons (e i) (e ∘ r) := by
  funext a
  refine Fin.cases ?_ (fun b => ?_) a <;> simp

/-! ### Restriction -/

variable {m : Type*}

lemma IsOffMinorIdx.comp {e : m → n} (he : Function.Injective e) {k : ℕ} {r c : Fin k → m}
    (h : IsOffMinorIdx r c) : IsOffMinorIdx (e ∘ r) (e ∘ c) :=
  ⟨he.comp h.1, he.comp h.2.1, fun a b hab => h.2.2 a b (he hab)⟩

lemma IsSeptadIdx.comp {e : m → n} (he : Function.Injective e) {i : m} {r c r' c' : Fin 3 → m}
    (h : IsSeptadIdx i r c r' c') : IsSeptadIdx (e i) (e ∘ r) (e ∘ c) (e ∘ r') (e ∘ c') := by
  refine ⟨h.1.comp he, h.2.1.comp he, ?_, ?_, ?_⟩
  · rintro ⟨a, ha⟩; exact h.2.2.1 ⟨a, he ha⟩
  · rintro ⟨a, ha⟩; exact h.2.2.2.1 ⟨a, he ha⟩
  · simp only [Set.range_comp, ← Set.image_union, h.2.2.2.2]

lemma septadVal_submatrix (M : Matrix n n A) (e : m → n) (i : m) (r c r' c' : Fin 3 → m) :
    septadVal (M.submatrix e e) i r c r' c' =
      septadVal M (e i) (e ∘ r) (e ∘ c) (e ∘ r') (e ∘ c') := by
  simp only [septadVal, submatrix_submatrix, comp_vecCons]

/-- **Restriction**: sub-patterns of a pattern on which the minors and septads vanish. -/
theorem msVanish_submatrix {M : Matrix n n A} (hM : MSVanish M) {e : m → n}
    (he : Function.Injective e) : MSVanish (M.submatrix e e) := by
  refine ⟨fun r c h => ?_, fun i r c r' c' h => ?_⟩
  · simpa [minorVal, submatrix_submatrix] using hM.1 _ _ (h.comp he)
  · rw [septadVal_submatrix]; exact hM.2 _ _ _ _ _ (h.comp he)

/-! ### Extension by zero rows and columns -/

lemma exists_comp_eq {e : m → n} {k : ℕ} {r : Fin k → n} (h : ∀ a, r a ∈ Set.range e) :
    ∃ r₀ : Fin k → m, e ∘ r₀ = r := by
  choose r₀ hr₀ using h
  exact ⟨r₀, funext hr₀⟩

lemma IsOffMinorIdx.of_comp {e : m → n} {k : ℕ} {r c : Fin k → m}
    (h : IsOffMinorIdx (e ∘ r) (e ∘ c)) : IsOffMinorIdx r c :=
  ⟨fun a b hab => h.1 (by simp [hab]), fun a b hab => h.2.1 (by simp [hab]),
    fun a b hab => h.2.2 a b (by simp [hab])⟩

lemma IsSeptadIdx.of_comp {e : m → n} (he : Function.Injective e) {i : m}
    {r c r' c' : Fin 3 → m} (h : IsSeptadIdx (e i) (e ∘ r) (e ∘ c) (e ∘ r') (e ∘ c')) :
    IsSeptadIdx i r c r' c' := by
  refine ⟨h.1.of_comp, h.2.1.of_comp, ?_, ?_, ?_⟩
  · rintro ⟨a, ha⟩; exact h.2.2.1 ⟨a, by simp [ha]⟩
  · rintro ⟨a, ha⟩; exact h.2.2.2.1 ⟨a, by simp [ha]⟩
  · have := h.2.2.2.2
    simp only [Set.range_comp, ← Set.image_union] at this
    exact Set.image_injective.2 he this

/-- **Extension by zeros** (the paper's argument for `p = 7`): if `M` has zero rows and columns
outside the image of the injective map `e`, and the minors and septads of `M[e, e]` vanish, then
those of `M` vanish. -/
theorem msVanish_of_zeroExt {M : Matrix n n A} {e : m → n} (he : Function.Injective e)
    (hz : ∀ u, u ∉ Set.range e → ∀ v, M u v = 0 ∧ M v u = 0)
    (hM : MSVanish (M.submatrix e e)) : MSVanish M := by
  -- a minor with an index outside the image has a zero row or column
  have hdet : ∀ {k : ℕ} (r c : Fin k → n), (∃ a, r a ∉ Set.range e) ∨ (∃ b, c b ∉ Set.range e) →
      (M.submatrix r c).det = 0 := by
    intro k r c h
    rcases h with ⟨a, ha⟩ | ⟨b, hb⟩
    · exact det_eq_zero_of_row_eq_zero a (fun j => (hz _ ha _).1)
    · exact det_eq_zero_of_column_eq_zero b (fun j => (hz _ hb _).2)
  refine ⟨fun r c h => ?_, fun i r c r' c' h => ?_⟩
  · by_cases hin : (∀ a, r a ∈ Set.range e) ∧ ∀ b, c b ∈ Set.range e
    · obtain ⟨r₀, rfl⟩ := exists_comp_eq hin.1
      obtain ⟨c₀, rfl⟩ := exists_comp_eq hin.2
      have := hM.1 r₀ c₀ h.of_comp
      simpa [minorVal, submatrix_submatrix] using this
    · apply hdet
      by_contra hc
      push Not at hc
      exact hin ⟨hc.1, hc.2⟩
  · by_cases hi : i ∈ Set.range e
    · by_cases hin : (∀ a, r a ∈ Set.range e) ∧ ∀ b, c b ∈ Set.range e
      · -- every index lies in the image: the septad is one of `M[e, e]`
        have hsub : Set.range r' ∪ Set.range c' ⊆ Set.range e := by
          rw [← h.2.2.2.2]
          rintro _ (⟨a, rfl⟩ | ⟨b, rfl⟩)
          · exact hin.1 a
          · exact hin.2 b
        obtain ⟨i₀, rfl⟩ := hi
        obtain ⟨r₀, rfl⟩ := exists_comp_eq hin.1
        obtain ⟨c₀, rfl⟩ := exists_comp_eq hin.2
        obtain ⟨r₀', rfl⟩ := exists_comp_eq (fun a => hsub (Or.inl ⟨a, rfl⟩))
        obtain ⟨c₀', rfl⟩ := exists_comp_eq (fun b => hsub (Or.inr ⟨b, rfl⟩))
        rw [← septadVal_submatrix]
        exact hM.2 _ _ _ _ _ (h.of_comp he)
      · -- an index `u ∈ R ∪ C = R' ∪ C'` outside the image kills both 3 × 3 minors
        have hu : ∃ u ∈ Set.range r ∪ Set.range c, u ∉ Set.range e := by
          by_contra hc
          push Not at hc
          exact hin ⟨fun a => hc _ (Or.inl ⟨a, rfl⟩), fun b => hc _ (Or.inr ⟨b, rfl⟩)⟩
        obtain ⟨u, hu1, hu2⟩ := hu
        have h1 : (M.submatrix r c).det = 0 := by
          apply hdet
          rcases hu1 with ⟨a, rfl⟩ | ⟨b, rfl⟩
          · exact Or.inl ⟨a, hu2⟩
          · exact Or.inr ⟨b, hu2⟩
        have h2 : (M.submatrix r' c').det = 0 := by
          apply hdet
          rw [h.2.2.2.2] at hu1
          rcases hu1 with ⟨a, rfl⟩ | ⟨b, rfl⟩
          · exact Or.inl ⟨a, hu2⟩
          · exact Or.inr ⟨b, hu2⟩
        rw [septadVal, h1, h2, zero_mul, zero_mul, sub_zero]
    · -- `i` outside the image: both 4 × 4 determinants have a zero first row
      have h1 : (M.submatrix (vecCons i r') (vecCons i c')).det = 0 :=
        hdet _ _ (Or.inl ⟨0, by simpa using hi⟩)
      have h2 : (M.submatrix (vecCons i r) (vecCons i c)).det = 0 :=
        hdet _ _ (Or.inl ⟨0, by simpa using hi⟩)
      rw [septadVal, h1, h2, mul_zero, mul_zero, sub_zero]

end Values

/-! ### Minors and septads vanish on the model (no hypothesis) -/

section Model

variable {n : Type*} {K : Type*} [Field K]

/-- **The determinant step of the septads.** If `M` agrees with `S` off the diagonal and has zero
diagonal, `r, c` are off-diagonal and `i` is outside `R ∪ C`, then
`det M[(i,r),(i,c)] = det S[(i,r),(i,c)] − S_ii · det S[r,c]`. -/
lemma det_cons_zeroDiag (S M : Matrix n n K) (hM : ∀ a b, a ≠ b → M a b = S a b)
    (hd : ∀ a, M a a = 0) (i : n) (r c : Fin 3 → n) (hrc : ∀ a b, r a ≠ c b)
    (hir : i ∉ Set.range r) (hic : i ∉ Set.range c) :
    (M.submatrix (vecCons i r) (vecCons i c)).det =
      (S.submatrix (vecCons i r) (vecCons i c)).det - S i i * (S.submatrix r c).det := by
  have hri : ∀ a, r a ≠ i := fun a h => hir ⟨a, h⟩
  have hci : ∀ b, c b ≠ i := fun b h => hic ⟨b, h⟩
  set P := M.submatrix (vecCons i r) (vecCons i c) with hPdef
  set N := S.submatrix (vecCons i r) (vecCons i c) with hNdef
  have hrows : ∀ f : Fin 3 → Fin 4, P.submatrix Fin.succ f = N.submatrix Fin.succ f := by
    intro f
    ext a b
    simp only [hPdef, hNdef, submatrix_apply, cons_val_succ]
    refine Fin.cases ?_ (fun b' => ?_) (f b)
    · simpa using hM _ _ (hri a)
    · simpa using hM _ _ (hrc a b')
  have h0 : ∀ j : Fin 3, P 0 j.succ = N 0 j.succ := by
    intro j
    simp only [hPdef, hNdef, submatrix_apply, cons_val_zero, cons_val_succ]
    exact hM _ _ (Ne.symm (hci j))
  have hP00 : P 0 0 = 0 := by simp only [hPdef, submatrix_apply, cons_val_zero]; exact hd i
  have hN00 : N 0 0 = S i i := by simp only [hNdef, submatrix_apply, cons_val_zero]
  have hsub : N.submatrix Fin.succ Fin.succ = S.submatrix r c := by
    ext a b; simp only [hNdef, submatrix_apply, cons_val_succ]
  rw [det_succ_row_zero P, det_succ_row_zero N]
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, hrows, h0, hP00, hN00, Fin.succAbove_zero, hsub,
    Fin.val_zero, pow_zero]
  ring

/-- **Minors and septads vanish** at every matrix with zero diagonal that agrees off the diagonal
with a matrix `S` all of whose `4 × 4` minors vanish (any field). -/
theorem msVanish_of_minors (S M : Matrix n n K) (hM : ∀ a b, a ≠ b → M a b = S a b)
    (hd : ∀ a, M a a = 0) (hS : ∀ f g : Fin 4 → n, (S.submatrix f g).det = 0) : MSVanish M := by
  have hoff : ∀ {k : ℕ} (r c : Fin k → n), (∀ a b, r a ≠ c b) →
      M.submatrix r c = S.submatrix r c := by
    intro k r c h; ext a b; exact hM _ _ (h a b)
  refine ⟨fun r c h => ?_, fun i r c r' c' h => ?_⟩
  · rw [minorVal, hoff r c h.2.2]; exact hS r c
  · have hi' := h.not_mem'
    rw [septadVal, hoff r c h.1.2.2, hoff r' c' h.2.1.2.2,
      det_cons_zeroDiag S M hM hd i r' c' h.2.1.2.2 hi'.1 hi'.2,
      det_cons_zeroDiag S M hM hd i r c h.1.2.2 h.2.2.1 h.2.2.2.1, hS, hS]
    ring

/-- The `4 × 4` minors of `Λ Λᵀ` vanish when `Λ` has three columns. -/
lemma det_submatrix_mul_transpose [Fintype n] (Λ : Matrix n (Fin 3) K) (f g : Fin 4 → n) :
    ((Λ * Λᵀ).submatrix f g).det = 0 := by
  by_contra h
  have hu : IsUnit ((Λ * Λᵀ).submatrix f g) :=
    (isUnit_iff_isUnit_det _).2 (isUnit_iff_ne_zero.2 h)
  have h1 := rank_of_isUnit _ hu
  have h2 : ((Λ * Λᵀ).submatrix f g).rank ≤ 3 :=
    (rank_submatrix_le _ _ _).trans ((rank_mul_le_left _ _).trans
      ((rank_le_card_width _).trans (by simp)))
  simp at h1
  omega

end Model

/-! ### The ideal `J_{p,3}` -/

section Ideal

variable {n : Type*} [LinearOrder n]

variable (n) in
/-- `Ψ⁰`: the symmetric matrix of the variables `ψ_ij` (`i < j`) with zero diagonal. -/
noncomputable def Psi0 : Matrix n n (MvPolynomial (SymIdx n) ℝ) :=
  Matrix.of fun a b => symEntryPoly (K := ℝ) a b

variable (n) in
/-- The off-diagonal `4 × 4` minors `det Ψ[R, C]`, `R ∩ C = ∅`. -/
def minorGens : Set (MvPolynomial (SymIdx n) ℝ) :=
  {g | ∃ r c : Fin 4 → n, IsOffMinorIdx r c ∧ g = minorVal (Psi0 n) r c}

variable (n) in
/-- The septads. -/
def septadGens : Set (MvPolynomial (SymIdx n) ℝ) :=
  {g | ∃ (i : n) (r c r' c' : Fin 3 → n), IsSeptadIdx i r c r' c' ∧
    g = septadVal (Psi0 n) i r c r' c'}

variable (n) in
/-- **`J_{p,3}`**: the ideal generated by the off-diagonal `4 × 4` minors and the septads. -/
noncomputable def Jideal : Ideal (MvPolynomial (SymIdx n) ℝ) :=
  Ideal.span (minorGens n ∪ septadGens n)

variable {K : Type*} [Field K] [Algebra ℝ K]

lemma aeval_symEntryPoly_real (z : SymIdx n → K) (a b : n) :
    aeval z (symEntryPoly (K := ℝ) a b) = toMatSym z a b := by
  unfold symEntryPoly toMatSym
  split_ifs <;> simp

lemma aeval_det_Psi0 (z : SymIdx n → K) {k : ℕ} (r c : Fin k → n) :
    aeval z ((Psi0 n).submatrix r c).det = ((toMatSym z).submatrix r c).det := by
  rw [← AlgHom.coe_toRingHom, RingHom.map_det]
  congr 1
  ext a b
  simp [Psi0, aeval_symEntryPoly_real, RingHom.mapMatrix_apply]

lemma aeval_septadVal (z : SymIdx n → K) (i : n) (r c r' c' : Fin 3 → n) :
    aeval z (septadVal (Psi0 n) i r c r' c') = septadVal (toMatSym z) i r c r' c' := by
  simp only [septadVal, map_sub, map_mul, aeval_det_Psi0]

lemma mem_zeroLocus_span_iff {σ : Type*} (S : Set (MvPolynomial σ ℝ)) (z : σ → K) :
    z ∈ zeroLocus K (Ideal.span S) ↔ ∀ g ∈ S, aeval z g = 0 := by
  rw [mem_zeroLocus_iff_le_ker, Ideal.span_le]
  exact ⟨fun h g hg => (RingHom.mem_ker).1 (h hg), fun h g hg => (RingHom.mem_ker).2 (h g hg)⟩

/-- **The zero set of `J`**: `z ∈ V(J)` iff all off-diagonal `4 × 4` minors and all septads
vanish at the pattern of `z`. -/
theorem mem_zeroLocus_Jideal_iff (z : SymIdx n → K) :
    z ∈ zeroLocus K (Jideal n) ↔ MSVanish (toMatSym z) := by
  rw [Jideal, mem_zeroLocus_span_iff]
  constructor
  · intro h
    refine ⟨fun r c hrc => ?_, fun i r c r' c' hs => ?_⟩
    · rw [minorVal, ← aeval_det_Psi0]; exact h _ (Or.inl ⟨r, c, hrc, rfl⟩)
    · rw [← aeval_septadVal]; exact h _ (Or.inr ⟨i, r, c, r', c', hs, rfl⟩)
  · rintro h g (⟨r, c, hrc, rfl⟩ | ⟨i, r, c, r', c', hs, rfl⟩)
    · rw [minorVal, aeval_det_Psi0]; exact h.1 r c hrc
    · rw [aeval_septadVal]; exact h.2 i r c r' c' hs

end Ideal

/-! ### `J_{p,3} ⊆ I_{p,3}` (no hypothesis) -/

section JleI

variable {ι : Type} [Fintype ι] [LinearOrder ι]

lemma toMatSym_symCoords_mul_transpose {K : Type*} [Field K] (Λ : Matrix ι (Fin 3) K) (a b : ι)
    (hab : a ≠ b) : toMatSym (symCoords (Λ * Λᵀ)) a b = (Λ * Λᵀ) a b := by
  rcases lt_or_gt_of_ne hab with h | h
  · rw [toMatSym_apply_lt _ h]; rfl
  · rw [toMatSym_apply_gt _ h]; exact mul_transpose_symm Λ b a

/-- **`J_{p,3} ⊆ I_{p,3}`**: the off-diagonal `4 × 4` minors and the septads vanish on the factor
analysis model with three factors (no hypothesis). -/
theorem Jideal_le_FAideal : Jideal ι ≤ FAideal ι 3 := by
  rw [Jideal, Ideal.span_le]
  intro g hg
  rw [SetLike.mem_coe, FAideal, mem_vanishingIdeal_iff, symCoords_FAmodel]
  rintro _ ⟨Λ, rfl⟩
  have hv : MSVanish (toMatSym (symCoords (Λ * Λᵀ))) :=
    msVanish_of_minors (Λ * Λᵀ) _ (toMatSym_symCoords_mul_transpose Λ) (toMatSym_apply_self _)
      (det_submatrix_mul_transpose Λ)
  have := (mem_zeroLocus_Jideal_iff (K := ℝ) (symCoords (Λ * Λᵀ))).2 hv
  exact this g (Ideal.subset_span hg)

/-- `I_{p,m}` is a radical ideal. -/
lemma FAideal_radical (m : ℕ) : (FAideal ι m).radical = FAideal ι m := by
  apply le_antisymm _ Ideal.le_radical
  rintro f ⟨k, hk⟩
  rw [FAideal, mem_vanishingIdeal_iff] at hk ⊢
  intro y hy
  have := hk y hy
  rw [map_pow] at this
  exact pow_eq_zero_iff'.1 this |>.1

end JleI

/-! ### The named hypothesis: [DSS07, Example 18] -/

/-- **The named hypothesis `DSSExample18`** ([DSS07, Example 18]; Singular, over `ℚ`): every
element of `I_{8,3}` has a power in `J_{8,3}`. What [DSS07] report is more: a minimal generating
set of `I_{8,3}` (14 of degree 4, 260 of degree 7, 168 of degree 8) of which the 14 and 120 of the
260 lie in `J_{8,3}` (after replacement), while the squares of the other 140 and of the 168 lie in
`J_{8,3}`. That implies this statement, once their ideal over `ℚ` is identified with `I_{8,3}` over
`ℝ` (standard; not formalized). Nothing else from the computation is used: not the generators,
their number, minimality or degrees, nor that squares (rather than some power) suffice. -/
def DSSExample18 : Prop := FAideal (Fin 8) 3 ≤ (Jideal (Fin 8)).radical

/-- `DSSExample18` is the same as `rad J_{8,3} = I_{8,3}`. -/
theorem dssExample18_iff_radical_eq :
    DSSExample18 ↔ (Jideal (Fin 8)).radical = FAideal (Fin 8) 3 := by
  constructor
  · intro h
    apply le_antisymm _ h
    rw [← FAideal_radical (ι := Fin 8) 3]
    exact Ideal.radical_mono Jideal_le_FAideal
  · intro h; rw [DSSExample18, h]

/-- `DSSExample18` is the same as: the complex variety of `J_{8,3}` lies in `X_{8,3}`. -/
theorem dssExample18_iff_points :
    DSSExample18 ↔ zeroLocus ℂ (Jideal (Fin 8)) ⊆ Xvar (K := ℂ) (Fin 8) 3 := by
  rw [← zeroLocus_FAideal]
  constructor
  · intro h
    rw [← zeroLocus_radical (K := ℂ) (Jideal (Fin 8))]
    exact zeroLocus_anti_mono h
  · intro h
    have heq : zeroLocus ℂ (Jideal (Fin 8)) = zeroLocus ℂ (FAideal (Fin 8) 3) :=
      Set.Subset.antisymm h (zeroLocus_anti_mono Jideal_le_FAideal)
    have := (radical_eq_iff_zeroLocus_eq (K := ℂ) _ _).2 heq
    rw [DSSExample18, this]
    exact Ideal.le_radical

/-! ### Relabelling, restriction and extension of points -/

section Points

variable {m n : Type*} [LinearOrder m] [LinearOrder n]

/-- The coordinate map `SymIdx m → SymIdx n` of a strictly monotone map `m → n`. -/
def symMap (e : m → n) (he : StrictMono e) : SymIdx m → SymIdx n :=
  fun q => ⟨(e q.1.1, e q.1.2), he q.2⟩

lemma symMap_injective (e : m → n) (he : StrictMono e) : Function.Injective (symMap e he) := by
  intro q q' h
  have h1 := congrArg (fun s : SymIdx n => s.1.1) h
  have h2 := congrArg (fun s : SymIdx n => s.1.2) h
  simp only [symMap] at h1 h2
  exact Subtype.ext (Prod.ext (he.injective h1) (he.injective h2))

variable [Fintype m] [Fintype n] {K : Type*} [Field K]

lemma toMatSym_comp_symMap (z : SymIdx n → K) (e : m → n) (he : StrictMono e) :
    toMatSym (z ∘ symMap e he) = (toMatSym z).submatrix e e := by
  ext a b
  rcases lt_trichotomy a b with h | h | h
  · rw [toMatSym_apply_lt _ h, submatrix_apply, toMatSym_apply_lt _ (he h)]; rfl
  · subst h; rw [toMatSym_apply_self, submatrix_apply, toMatSym_apply_self]
  · rw [toMatSym_apply_gt _ h, submatrix_apply, toMatSym_apply_gt _ (he h)]; rfl

/-- `c` does not increase on sub-patterns. -/
lemma minCompRank_submatrix_le (x : Matrix n n K) (hx : ∀ a, x a a = 0) (e : m → n)
    (he : Function.Injective e) : minCompRank (x.submatrix e e) ≤ minCompRank x := by
  obtain ⟨d, hd⟩ := exists_minCompRank x
  refine (minCompRank_le_of_offDiag _ ((x + diagonal d).submatrix e e) (fun a => hx _)
    (fun a b hab => ?_)).trans ((rank_submatrix_le _ _ _).trans hd.le)
  simp [diagonal_apply_ne _ (he.ne hab)]

/-- **Sub-patterns of points of `X_{n,k}` lie in `X_{m,k}`** (any field, no hypothesis): the
coordinate projection is a polynomial map, so it maps the closure of `{c ≤ k}` into the closure of
`{c ≤ k}`. -/
theorem Xvar_comp_symMap (k : ℕ) (z : SymIdx n → K) (hz : z ∈ Xvar n k) (e : m → n)
    (he : StrictMono e) : z ∘ symMap e he ∈ Xvar m k := by
  rw [Xvar, zariskiClosure, mem_zeroLocus_iff] at hz ⊢
  intro f hf
  rw [mem_vanishingIdeal_iff] at hf
  have := hz (rename (symMap e he) f) (by
    rw [mem_vanishingIdeal_iff]
    intro s hs
    rw [aeval_rename]
    apply hf
    show minCompRank (toMatSym (s ∘ symMap e he)) ≤ k
    rw [toMatSym_comp_symMap]
    exact (minCompRank_submatrix_le _ (toMatSym_apply_self _) e he.injective).trans hs)
  rwa [aeval_rename] at this

omit [Fintype m] [Fintype n] [Field K] in
lemma restrictSym_eq_comp (z : SymIdx n → K) (T : Finset n) :
    restrictSym z T = z ∘ symMap (Subtype.val : T → n) (fun _ _ h => h) := rfl

/-- **Restriction of `V(J)`** (no hypothesis). -/
theorem comp_symMap_mem_zeroLocus_Jideal [Algebra ℝ K] (z : SymIdx n → K)
    (hz : z ∈ zeroLocus K (Jideal n)) (e : m → n) (he : StrictMono e) :
    z ∘ symMap e he ∈ zeroLocus K (Jideal m) := by
  rw [mem_zeroLocus_Jideal_iff] at hz ⊢
  rw [toMatSym_comp_symMap]
  exact msVanish_submatrix hz he.injective

open Classical in
/-- The extension of a pattern on `m` to `n` by zero entries outside the image of `e`. -/
noncomputable def extendZero (e : m → n) (he : StrictMono e) (x : SymIdx m → K) :
    SymIdx n → K :=
  fun q => if h : ∃ q', symMap e he q' = q then x h.choose else 0

omit [Fintype n] in
lemma extendZero_comp (e : m → n) (he : StrictMono e) (x : SymIdx m → K) :
    extendZero e he x ∘ symMap e he = x := by
  funext q
  rw [Function.comp_apply]
  unfold extendZero
  split_ifs with h
  · exact congrArg x (symMap_injective e he h.choose_spec)
  · exact absurd ⟨q, rfl⟩ h

lemma toMatSym_extendZero_eq_zero (e : m → n) (he : StrictMono e) (x : SymIdx m → K) (u : n)
    (hu : u ∉ Set.range e) (v : n) : toMatSym (extendZero e he x) u v = 0 := by
  rcases lt_trichotomy u v with h | h | h
  · rw [toMatSym_apply_lt _ h]
    unfold extendZero
    split_ifs with hq
    · obtain ⟨q', hq'⟩ := hq
      exact absurd ⟨q'.1.1, congrArg (fun s : SymIdx n => s.1.1) hq'⟩ hu
    · rfl
  · subst h; exact toMatSym_apply_self _ _
  · rw [toMatSym_apply_gt _ h]
    unfold extendZero
    split_ifs with hq
    · obtain ⟨q', hq'⟩ := hq
      exact absurd ⟨q'.1.2, congrArg (fun s : SymIdx n => s.1.2) hq'⟩ hu
    · rfl

/-- **Extension of `V(J)` by zero entries** (no hypothesis): the paper's step for `p = 7`, for any
strictly monotone `e`. -/
theorem extendZero_mem_zeroLocus_Jideal [Algebra ℝ K] (e : m → n) (he : StrictMono e)
    (x : SymIdx m → K) (hx : x ∈ zeroLocus K (Jideal m)) :
    extendZero e he x ∈ zeroLocus K (Jideal n) := by
  rw [mem_zeroLocus_Jideal_iff] at hx ⊢
  apply msVanish_of_zeroExt he.injective
  · intro u hu v
    exact ⟨toMatSym_extendZero_eq_zero e he x u hu v,
      (toMatSym_symm _ v u).trans (toMatSym_extendZero_eq_zero e he x u hu v)⟩
  · rw [← toMatSym_comp_symMap _ e he, extendZero_comp]; exact hx

end Points

/-! ### The variety of `J_{p,3}` -/

section Variety

/-- **At most eight indices** (under `DSSExample18` only): `V_ℂ(J_{m,3}) ⊆ X_{m,3}` for every
finite linear order `m` that embeds in `Fin 8`. The pattern is extended by zero entries to eight
indices. This covers `p ≤ 7` and, in particular, `p ≤ 6`. -/
theorem zeroLocus_Jideal_subset_of_emb (h8 : DSSExample18) {m : Type*} [Fintype m]
    [LinearOrder m] (e : m → Fin 8) (he : StrictMono e) :
    zeroLocus ℂ (Jideal m) ⊆ Xvar (K := ℂ) m 3 := by
  intro z hz
  have h1 := extendZero_mem_zeroLocus_Jideal e he z hz
  have h2 := dssExample18_iff_points.1 h8 h1
  have h3 := Xvar_comp_symMap 3 _ h2 e he
  rwa [extendZero_comp] at h3

theorem zeroLocus_Jideal_subset_of_le_eight (h8 : DSSExample18) {p : ℕ} (hp : p ≤ 8) :
    zeroLocus ℂ (Jideal (Fin p)) ⊆ Xvar (K := ℂ) (Fin p) 3 :=
  zeroLocus_Jideal_subset_of_emb h8 (Fin.castLE hp) (fun _ _ h => h)

/-- **At least eight indices** (under `ClosedRhoSym ℂ` and `DSSExample18`): by Theorem 3 with
`k = 3`, it suffices that each sub-pattern on eight indices lies in `X_{T,3}`, and it lies in
`V(J_{T,3})`. -/
theorem zeroLocus_Jideal_subset_of_ge_eight (hC : ClosedRhoSym.{0, 0} ℂ) (h8 : DSSExample18)
    {n : Type} [Fintype n] [LinearOrder n] (hn : 8 ≤ Fintype.card n) :
    zeroLocus ℂ (Jideal n) ⊆ Xvar (K := ℂ) n 3 := by
  intro z hz
  rw [theorem_3_sym hC 3 (by simpa using hn) z]
  intro T hT
  rw [restrictSym_eq_comp]
  have hzT := comp_symMap_mem_zeroLocus_Jideal z hz (Subtype.val : T → n) (fun _ _ h => h)
  set e : T ≃o Fin 8 := (T.orderIsoOfFin hT).symm
  exact zeroLocus_Jideal_subset_of_emb h8 e e.strictMono hzT

/-- From the variety to the ideal: if `V_ℂ(J_{p,3}) ⊆ X_{p,3}` then `rad J_{p,3} = I_{p,3}`. -/
theorem radical_Jideal_eq_of_zeroLocus {p : ℕ}
    (h : zeroLocus ℂ (Jideal (Fin p)) ⊆ Xvar (K := ℂ) (Fin p) 3) :
    (Jideal (Fin p)).radical = FAideal (Fin p) 3 := by
  rw [← FAideal_radical 3]
  apply (radical_eq_iff_zeroLocus_eq (K := ℂ) _ _).2
  rw [zeroLocus_FAideal]
  exact Set.Subset.antisymm h (by
    rw [← zeroLocus_FAideal]; exact zeroLocus_anti_mono Jideal_le_FAideal)

end Variety

/-! ### Theorem 6 -/

/-- **Theorem 6 for `p ≤ 8`** (under `DSSExample18` only; no projection theorem needed). -/
theorem theorem_6_le_eight (h8 : DSSExample18) {p : ℕ} (hp : p ≤ 8) :
    (Jideal (Fin p)).radical = FAideal (Fin p) 3 :=
  radical_Jideal_eq_of_zeroLocus (zeroLocus_Jideal_subset_of_le_eight h8 hp)

/-- **Theorem 6 (Conjecture 28 of [DSS07])** (under `ClosedRhoSym ℂ` and `DSSExample18`): for
every `p`, the radical of `J_{p,3}` is `I_{p,3}`. -/
theorem theorem_6_closedRho (hC : ClosedRhoSym.{0, 0} ℂ) (h8 : DSSExample18) (p : ℕ) :
    (Jideal (Fin p)).radical = FAideal (Fin p) 3 := by
  rcases le_total p 8 with hp | hp
  · exact theorem_6_le_eight h8 hp
  · exact radical_Jideal_eq_of_zeroLocus
      (zeroLocus_Jideal_subset_of_ge_eight hC h8 (by simpa using hp))

/-- **Theorem 6 (Conjecture 28 of [DSS07])** (under `ProjClosed ℂ` and `DSSExample18`). -/
theorem theorem_6 (hP : ProjClosed ℂ) (h8 : DSSExample18) (p : ℕ) :
    (Jideal (Fin p)).radical = FAideal (Fin p) 3 :=
  theorem_6_closedRho (closedRhoSym_of_projClosed hP) h8 p

/-! ### `p ≤ 6` -/

/-- For `p ≤ 6` there are no off-diagonal `4 × 4` minors and no septads: `J_{p,3} = 0`
(no hypothesis). -/
theorem Jideal_eq_bot_of_card_le {n : Type*} [Fintype n] [LinearOrder n]
    (hn : Fintype.card n ≤ 6) : Jideal n = ⊥ := by
  rw [Jideal, Ideal.span_eq_bot]
  rintro g (⟨r, c, h, -⟩ | ⟨i, r, c, r', c', h, -⟩)
  · exfalso
    have hinj : Function.Injective (Sum.elim r c) := by
      rintro (a | a) (b | b) hab
      · simp only [Sum.elim_inl] at hab; rw [h.1 hab]
      · exact absurd hab (h.2.2 a b)
      · exact absurd hab.symm (h.2.2 b a)
      · simp only [Sum.elim_inr] at hab; rw [h.2.1 hab]
    have := Fintype.card_le_of_injective _ hinj
    simp at this; omega
  · exfalso
    have hinj : Function.Injective (fun o : Option (Fin 3 ⊕ Fin 3) => o.elim i (Sum.elim r c)) := by
      rintro (_ | a | a) (_ | b | b) hab <;> simp only [Option.elim, Sum.elim_inl,
        Sum.elim_inr] at hab
      · rfl
      · exact absurd ⟨b, hab.symm⟩ h.2.2.1
      · exact absurd ⟨b, hab.symm⟩ h.2.2.2.1
      · exact absurd ⟨a, hab⟩ h.2.2.1
      · rw [h.1.1 hab]
      · exact absurd hab (h.1.2.2 a b)
      · exact absurd ⟨a, hab⟩ h.2.2.2.1
      · exact absurd hab.symm (h.1.2.2 b a)
      · rw [h.1.2.1 hab]
    have := Fintype.card_le_of_injective _ hinj
    simp at this; omega

/-- **`p ≤ 6`** (under `DSSExample18` only): `I_{p,3} = 0`. The paper cites the codimension
formula [DSS07, Theorem 2]; here it follows from Example 18 by the zero extension. -/
theorem FAideal_eq_bot_of_le_six (h8 : DSSExample18) {p : ℕ} (hp : p ≤ 6) :
    FAideal (Fin p) 3 = ⊥ := by
  rw [← theorem_6_le_eight h8 (by omega), Jideal_eq_bot_of_card_le (by simpa using hp)]
  exact Ideal.radical_bot_of_isReduced

/-! ### The literal reading of the paper's septad definition is too wide -/

/-- **The septad definition of the paper's Section 3, read literally, includes polynomials outside
`I_{7,3}`.** Take `R = R̄ = {0,1,2}`, `C = C̄ = {3,4,5}`, `i = 6`, `g = det Ψ⁰[{6},{6}]` and
`h = det Ψ⁰[{6,0},{6,0}]`. The row and column sets of `g` and `h` contain `i ∉ R ∪ C`, so
`det Ψ[R,C] · g − det Ψ[R̄,C̄] · h` has the form described ("`g`, `h` are determinants of submatrices of
`Ψ⁰` whose row and column sets both contain an index `i ∉ R ∪ C`"). It equals
`det Ψ[R,C] · ψ_06²`, which is not in `I_{7,3}`. -/
theorem literal_septad_not_mem :
    ((Psi0 (Fin 7)).submatrix ![0, 1, 2] ![3, 4, 5]).det *
        ((Psi0 (Fin 7)).submatrix ![6] ![6]).det -
      ((Psi0 (Fin 7)).submatrix ![0, 1, 2] ![3, 4, 5]).det *
        ((Psi0 (Fin 7)).submatrix ![6, 0] ![6, 0]).det ∉ FAideal (Fin 7) 3 := by
  intro h
  rw [FAideal, mem_vanishingIdeal_iff, symCoords_FAmodel] at h
  set Λ : Matrix (Fin 7) (Fin 3) ℝ :=
    Matrix.of ![![1, 0, 0], ![0, 1, 0], ![0, 0, 1], ![1, 0, 0], ![0, 1, 0], ![0, 0, 1], ![1, 0, 0]]
  have h0 := h _ ⟨Λ, rfl⟩
  simp only [map_sub, map_mul, aeval_det_Psi0] at h0
  have hent : ∀ a b : Fin 7, a ≠ b → toMatSym (symCoords (Λ * Λᵀ)) a b = (Λ * Λᵀ) a b :=
    toMatSym_symCoords_mul_transpose Λ
  have e1 : ((toMatSym (symCoords (Λ * Λᵀ))).submatrix ![0, 1, 2] ![3, 4, 5]).det = 1 := by
    have : (toMatSym (symCoords (Λ * Λᵀ))).submatrix ![(0 : Fin 7), 1, 2] ![3, 4, 5] = 1 := by
      ext a b
      rw [submatrix_apply, hent _ _ (by fin_cases a <;> fin_cases b <;> decide)]
      fin_cases a <;> fin_cases b <;>
        simp [Λ, Matrix.mul_apply, Fin.sum_univ_three]
    rw [this, det_one]
  have e2 : ((toMatSym (symCoords (Λ * Λᵀ))).submatrix ![(6 : Fin 7)] ![6]).det = 0 := by
    rw [det_fin_one]; simp [toMatSym_apply_self]
  have e3 : ((toMatSym (symCoords (Λ * Λᵀ))).submatrix ![(6 : Fin 7), 0] ![6, 0]).det = -1 := by
    rw [det_fin_two]
    simp only [submatrix_apply, cons_val_zero, cons_val_one, toMatSym_apply_self]
    rw [hent 6 0 (by decide), hent 0 6 (by decide)]
    simp [Λ, Matrix.mul_apply, Fin.sum_univ_three]
  rw [e1, e2, e3] at h0
  norm_num at h0

end FreeDiagonal
